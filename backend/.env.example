# VVE Tooling Backend - Environment Variables
# Copy this file to .env and update with your values

# Application
APP_NAME="VVE Tooling API"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_PREFIX=/api/v1
# ALLOWED_ORIGINS configures which frontend URLs can access the API (CORS).
# For local development without Docker: http://localhost:3000
# For Docker Compose dev (via nginx on port 81): http://localhost:81
# Docker network hostnames: http://frontend:3000, http://nginx
# Multiple origins: ["http://localhost:3000","http://localhost:81","http://frontend:3000","http://nginx"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:81","http://frontend:3000","http://nginx"]

# Database (PostgreSQL)
# Use DATABASE_URL or the individual DATABASE_* settings below
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vvetooling
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Authentication (AWS Cognito - for production)
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# JWT Configuration (for local development)
JWT_SECRET_KEY=change-this-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 Storage
S3_BUCKET_NAME=vvetooling-documents
S3_REGION=eu-central-1
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
