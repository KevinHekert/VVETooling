# VVE Tooling Backend - Environment Variables
# Copy this file to .env and update with your values

# Application
APP_NAME="VVE Tooling API"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vvetooling

# Authentication (AWS Cognito - for production)
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# JWT Configuration (for local development)
JWT_SECRET_KEY=change-this-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 Storage
S3_BUCKET_NAME=vvetooling-documents
S3_REGION=eu-central-1
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
